    <string name="setup_welcome_body">Hear It reads your notifications aloud through your headphones. Everything stays on this device \u2014 no account, no cloud, no analytics.</string>
    <string name="setup_welcome_point_1">You choose which apps may be read aloud. All apps start disabled.</string>
    <string name="setup_welcome_point_2">Announcements follow your rules: screen and lock state, silence, do not disturb, calls and output devices.</string>
    <string name="setup_welcome_point_3">The next eight steps set up permissions, speech, apps and outputs. You start the service explicitly at the end.</string>

    <string name="setup_notification_access_body">Hear It needs notification access so it can see the notifications you allow it to read. It reads only the apps you enable, never stores content outside your chosen history mode, and never sends anything off the device.</string>
    <string name="setup_notification_access_status">Notification access: %1$s</string>
    <string name="setup_notification_access_open">Open notification access settings</string>

    <string name="setup_bluetooth_body">Android 12 and later ask for nearby-device (Bluetooth) permission so Hear It can see connected headphones and stop speaking when they disconnect. Without it announcements still work, but device names may be unavailable.</string>
    <string name="setup_bluetooth_status">Bluetooth permission: %1$s</string>
    <string name="setup_bluetooth_request">Allow Bluetooth access</string>

    <string name="setup_tts_body">Announcements use the text-to-speech engine installed on this device. Hear It does not translate text or download voices; if your language is missing, install its voice data in the system text-to-speech settings.</string>
    <string name="setup_tts_engine_status">Speech engine: %1$s</string>
    <string name="setup_tts_language_status">Device language: %1$s</string>

    <string name="setup_battery_body">Android may stop background apps to save power. If announcements stop while the screen is off, allow Hear It to run without battery restrictions. No app can guarantee background execution, and behaviour differs by manufacturer.</string>
    <string name="setup_battery_open">Open battery settings</string>
    <string name="setup_battery_acknowledge">I understand that battery optimisation can interrupt announcements</string>

    <string name="setup_apps_body">Choose which apps Hear It may read aloud. Everything starts disabled, and you can change this later per app.</string>
    <string name="setup_apps_enabled_count">%1$d enabled</string>
    <string name="setup_apps_loading">Loading installed apps\u2026</string>
    <string name="setup_apps_empty">No apps with a launcher icon were found.</string>

