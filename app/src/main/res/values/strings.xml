    <string name="setup_devices_none_detected">No Bluetooth or wired output is connected right now.</string>
    <string name="setup_device_unknown">Audio device</string>

    <string name="setup_test_body">Play a short announcement through the current speech settings. The test does not create a history entry and does not use the announcement queue.</string>
    <string name="setup_test_play">Play test announcement</string>
    <string name="setup_test_speaking">Speaking…</string>
    <string name="setup_test_completed">Test announcement finished.</string>
    <string name="setup_test_failed">The test announcement could not be spoken. Check the speech engine and language data.</string>
    <string name="setup_test_announcement_spoken">This is a test announcement from Hear It.</string>

    <string name="setup_review_body">Review your choices, then start Hear It. Nothing runs until you press Start, and opening the app later never starts it silently.</string>
