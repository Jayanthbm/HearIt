<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Foreground-service permissions for the announcement service's
         foregroundServiceType="mediaPlayback" (ADR-010, targetSdk 34+).
         Both are install-time NORMAL permissions: silently granted, never shown to
         the user, so no setup-flow explanation is owed for them. Runtime/DANGEROUS
         permissions (POST_NOTIFICATIONS, BLUETOOTH_CONNECT) are intentionally NOT
         declared yet — each lands with the setup flow that explains it (P06
         acceptance criterion). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".HearItApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HearIt">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HearIt"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification-listener slot: the class now lives in :core:notifications (P07)
             and is on :app's runtime classpath. exported=true with the signature-level
             BIND_NOTIFICATION_LISTENER_SERVICE permission is the mandatory pattern on
             every API 29–37: only the system can bind, and it does so only after the user
             grants notification access in the setup flow (architecture: "enabled only
             after the user grants notification access"). -->
        <service
            android:name="com.jayanth.hearit.core.notifications.HearItNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Foreground announcement service (P08): one foreground service hosts the
             queue + TTS loop and the persistent notification (ADR-010). exported=false:
             only this app starts it, and only on explicit user action. The
             foregroundServiceType attribute exists from API 29 (our minSdk floor) and is
             enforced from targetSdk 34; mediaPlayback requires the normal
             FOREGROUND_SERVICE_MEDIA_PLAYBACK permission declared above. -->
        <service
            android:name=".service.AnnouncementService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
